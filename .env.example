# ============================================================
# OLLAMA
# ============================================================

# OLLAMA_BASE_URL — только для запуска БЕЗ Docker (локальный python).
# Внутри docker-compose переопределяется автоматически на http://ollama:11434
# (см. секцию environment сервиса api в docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434

LLM_MODEL=qwen3:8b

LLM_TEMPERATURE=0.1

LLM_MAX_TOKENS=512

LLM_CONTEXT_TOKENS=2048

# Максимальное время чтения ответа от Ollama.
LLM_READ_TIMEOUT=180

# Количество попыток прогрева.
LLM_WARMUP_RETRIES=3

# Пауза между попытками прогрева.
LLM_WARMUP_DELAY=2

# ============================================================



# ============================================================
# API
# ============================================================

CORS_ALLOWED_ORIGINS=["*"]

RATE_LIMIT_PER_MINUTE=20

MAX_MESSAGE_LENGTH=1000

LOG_LEVEL=INFO