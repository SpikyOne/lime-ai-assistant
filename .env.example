# OLLAMA_BASE_URL — только для запуска БЕЗ Docker (локальный python).
# Внутри docker-compose переопределяется автоматически на http://ollama:11434
# (см. секцию environment сервиса api в docker-compose.yml).
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_LENGTH=1000

LOG_LEVEL=INFO