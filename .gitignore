# ==========================================
# Виртуальное окружение
# ==========================================
.venv/
/.venv/
venv/
env/
ENV/

# ==========================================
# Настройки IDE и редакторов
# ==========================================
.idea/
/.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Кэш и скомпилированные файлы Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/


# ==========================================
# Данные и Векторное хранилище (RAG)
# ==========================================
# Физические файлы векторной базы данных ChromaDB
storage/chroma/*

# Исходные файлы данных (игнорируем содержимое, сохраняем папку)
data/*
!data/.gitkeep

# Локальные модели и кэш (HuggingFace / Sentence-Transformers)
.cache/
models/*
!models/.gitkeep

# ==========================================
# Логи и временные файлы
# ==========================================
logs/*
*.log
tmp/

# ==========================================
# Секреты и конфигурация окружения
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Служебные файлы операционных систем
# ==========================================
.DS_Store
Thumbs.db